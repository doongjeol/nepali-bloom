  "dialogues": [
    {
      "title": "PART I: DIALOGUE (a) 외모 묘사",
      "lines": [
        {
          "speaker": "A",
          "nepali": "तपाईंको कपाल कस्तो छ ?",
          "romanized": "tapaaïko kapaal kasto chha ?",
          "korean": "당신의 머리카락은 कौन 색입니까?"
        },
        {
          "speaker": "B",
          "nepali": "मेरो कपाल कालो छ।",
          "romanized": "mero kapaal kaalo chha.",
          "korean": "제 머리카락은 검은색입니다."
        },
        {
          "speaker": "A",
          "nepali": "तपाईंको आँखा नि ?",
          "romanized": "tapaaïko aankhaa ni ?",
          "korean": "눈은요?"
        },
        {
          "speaker": "B",
          "nepali": "मेरो आँखा फिका निलो छ।",
          "romanized": "mero aankhaa phiikaa nilo chha.",
          "korean": "제 눈은 연한 파란색입니다."
        },
        {
          "speaker": "A",
          "nepali": "तपाईंको नाक कस्तो छ ?",
          "romanized": "tapaaïko naak kasto chha ?",
          "korean": "코는 어떤가요?"
        },
        {
          "speaker": "B",
          "nepali": "मेरो नाक अलि ठूलो छ।",
          "romanized": "mero naak ali Thulo chha.",
          "korean": "제 코는 조금 큽니다."
        },
        {
          "speaker": "A",
          "nepali": "तपाईंको उचाइ कति छ ?",
          "romanized": "tapaaïko uchchaai kati chha ?",
          "korean": "키가 얼마나 되나요?"
        },
        {
          "speaker": "B",
          "nepali": "मेरो उचाइ पाँच फिट तीन इन्च छ।",
          "romanized": "mero uchchaai paach phiT tin inch chha.",
          "korean": "제 키는 5피트 3인치입니다."
        }
      ]
    },
    {
      "title": "PART I: DIALOGUE (b) 사람의 특징",
      "lines": [
