  "dialogues": [
    {
      "title": "PART I: DIALOGUE (a) 영화 취향",
      "lines": [
        {
          "speaker": "A",
          "nepali": "तपाईंलाई सिनेमा मनपर्छ ?",
          "romanized": "tapaaïlaai sinemaa manparchha ?",
          "korean": "당신은 영화를 좋아합니까?"
        },
        {
          "speaker": "B",
          "nepali": "मनपर्छ।",
          "romanized": "manparchha.",
          "korean": "네, 좋아합니다."
        },
        {
          "speaker": "A",
          "nepali": "कस्तो सिनेमा मनपर्छ ?",
          "romanized": "kasto sinemaa manparchha ?",
          "korean": "어떤 영화를 좋아하나요?"
        },
        {
          "speaker": "B",
          "nepali": "मलाई नेपाली सिनेमा मनपर्छ।",
          "romanized": "malaai nepaali sinemaa manparchha.",
          "korean": "저는 네팔 영화를 좋아합니다."
        },
        {
          "speaker": "A",
          "nepali": "तपाईं सिनेमा हेर्न कहाँ जानुहुन्छ ?",
          "romanized": "tapaaï sinemaa herna kahãã jaanuhunchha ?",
          "korean": "영화를 보러 어디로 가시나요?"
        },
        {
          "speaker": "B",
          "nepali": "म विश्वज्योति सिनेमा हलमा जान्छु।",
          "romanized": "ma biswojyoti sinemaa halmaa jaanchhu.",
          "korean": "저는 비쇼죠티 영화관에 갑니다."
        },
        {
          "speaker": "A",
          "nepali": "तपाईंको साथीलाई नि ?",
          "romanized": "tapaaïko saathilaai ni ?",
          "korean": "당신의 친구는요?"
        },
        {
          "speaker": "B",
          "nepali": "उसलाई पनि नेपाली सिनेमा मनपर्छ।",
          "romanized": "uslaai pani nepaali sinemaa manparchha.",
          "korean": "그(녀)도 네팔 영화를 좋아합니다."
        }
      ]
    },
    {
      "title": "PART I: DIALOGUE (b) 여행과 취미",
      "lines": [
