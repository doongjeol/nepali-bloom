        {
          "speaker": "B",
          "nepali": "पूर्व त्यहाँ छ।",
          "romanized": "purb tyahãã chha.",
          "korean": "동쪽은 저기입니다."
        },
        {
          "speaker": "A",
          "nepali": "पश्चिम नि ?",
          "romanized": "pachhim ni ?",
          "korean": "서쪽은요?"
        },
        {
          "speaker": "B",
          "nepali": "पश्चिम मेरो पछाडि छ।",
          "romanized": "pachhim mero pachhaadi chha.",
          "korean": "서쪽은 제 뒤에 있습니다."
        },
        {
          "speaker": "A",
          "nepali": "तपाईंको दायाँतिर के छ ?",
          "romanized": "tapaaïko daayaatira ke chha ?",
          "korean": "당신의 오른쪽에 무엇이 있습니까?"
        },
        {
          "speaker": "B",
          "nepali": "मेरो दायाँतिर ब्ल्याकबोर्ड छ।",
          "romanized": "mero daayaatira blyaakborD chha.",
          "korean": "제 오른쪽には 칠판이 있습니다."
        },
        {
          "speaker": "A",
          "nepali": "बायाँतिर नि ?",
          "romanized": "waayaatira ni ?",
          "korean": "왼쪽은요?"
        },
        {
          "speaker": "B",
          "nepali": "बायाँतिर झ्याल छ।",
          "romanized": "waayaatira jhyaal chha.",
          "korean": "왼쪽에는 창문이 있습니다."
