  "dialogues": [
    {
      "title": "PART I: DIALOGUE (a) 선물 사기",
      "lines": [
        {
          "speaker": "A",
          "nepali": "तपाईं के खोज्दैछ ?",
          "romanized": "tapaaï ke khojdaichha ?",
          "korean": "당신은 무엇을 찾고 있습니까?"
        },
        {
          "speaker": "B",
          "nepali": "म टोपी खोज्दैछु।",
          "romanized": "ma topi khojdaichhu.",
          "korean": "저는 모자(토피)를 찾고 있습니다."
        },
        {
          "speaker": "A",
          "nepali": "कसको लागि ?",
          "romanized": "kasko laagi ?",
          "korean": "누구를 위한 것인가요?"
        },
        {
          "speaker": "B",
          "nepali": "मेरो बाको लागि।",
          "romanized": "mero baako laagi.",
          "korean": "저희 아버지를 위한 것입니다."
        },
        {
          "speaker": "A",
          "nepali": "यो कस्तो छ ?",
          "romanized": "yo kasto chha ?",
          "korean": "이것은 어떤가요?"
        },
        {
          "speaker": "B",
          "nepali": "यो धेरै राम्रो छ।",
          "romanized": "yo dherai raamro chha.",
          "korean": "이것은 매우 좋네요."
        },
        {
          "speaker": "A",
          "nepali": "यसको कति पर्छ ?",
          "romanized": "yesko kati parchha ?",
          "korean": "이것은 가격이 얼마인가요?"
        },
        {
          "speaker": "B",
          "nepali": "यसको पन्ध्र रुपैयाँ पर्छ।",
          "romanized": "yesko pandhra rupiyaa parchha.",
          "korean": "이것은 15루피입니다."
        }
      ]
    },
    {
      "title": "PART I: DIALOGUE (b) 의무와 일과",
      "lines": [
        {
          "speaker": "A",
          "nepali": "आज तपाईंलाई धेरै काम छ ?",
          "romanized": "aaja tapaaïlaai dherai kaam chha ?",
          "korean": "오늘 당신은 일이 많습니까?"
        },
        {
          "speaker": "B",
          "nepali": "हो, धेरै काम छ।",
          "romanized": "ho, dherai kaam chha.",
          "korean": "네, 일이 많습니다."
        },
        {
          "speaker": "A",
          "nepali": "के के गर्नु पर्छ ?",
          "romanized": "ke ke garnu parchha ?",
          "korean": "무엇무엇을 해야 하나요?"
        },
        {
          "speaker": "B",
          "nepali": "लुगा धुनु पर्छ र नुहाउनु पर्छ।",
          "romanized": "lugaa dhunu parchha ra nuhããunu parchha.",
          "korean": "옷을 빨아야 하고 목욕을 해야 합니다."
        },
        {
          "speaker": "A",
          "nepali": "दारी पनि काट्नु पर्छ ?",
          "romanized": "daahri pani kaaTnu parchha ?",
          "korean": "면도도 해야 하나요?"
        },
        {
          "speaker": "B",
          "nepali": "पर्छ।",
          "romanized": "parchha.",
          "korean": "네, 해야 합니다."
        }
      ]
    },
    {
      "title": "PART II: PRACTICE (a) 비누의 용도",
      "lines": [
        {
          "speaker": "A",
          "nepali": "यो के हो ?",
          "romanized": "yo ke ho ?",
          "korean": "이것은 무엇입니까?"
        },
        {
          "speaker": "B",
          "nepali": "यो साबुन हो।",
          "romanized": "yo saabun ho.",
          "korean": "이것은 비누입니다."
        },
        {
          "speaker": "A",
          "nepali": "साबुन के को लागि हो ?",
          "romanized": "saabun ke ko laagi ho ?",
          "korean": "비누는 무엇을 위한 것입니까?"
        },
        {
          "speaker": "B",
          "nepali": "साबुन नुहाउनको लागि हो।",
          "romanized": "saabun nuhããunako laagi ho.",
          "korean": "비누는 목욕하기 위한 것입니다."
        },
        {
          "speaker": "A",
          "nepali": "लुगा धुनको लागि के चाहिन्छ ?",
          "romanized": "lugaa dhunako laagi ke chaahinchha ?",
          "korean": "옷을 빨기 위해서는 무엇이 필요합니까?"
        },
        {
          "speaker": "B",
          "nepali": "लुगा धुनको लागि पनि साबुन चाहिन्छ।",
          "romanized": "lugaa dhunako laagi pani saabun chaahinchha.",
          "korean": "옷을 빨기 위해서도 비누가 필요합니다."
        }
      ]
    },
    {
      "title": "PART II: PRACTICE (b) 의무 표현 연습",
      "lines": [
        {
          "speaker": "A",
          "nepali": "तपाईंलाई भोक लाग्यो भने के गर्नु पर्छ ?",
