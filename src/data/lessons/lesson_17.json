          "nepali": "पानी पिउनु पर्छ।",
          "romanized": "paani piunu parchha.",
          "korean": "물을 마셔야 합니다."
        },
        {
          "speaker": "A",
          "nepali": "थकाइ लाग्यो भने के गर्नु पर्छ ?",
          "romanized": "thakaai laagyo bhane ke garnu parchha ?",
          "korean": "피곤하다면 무엇을 해야 합니까?"
        },
        {
          "speaker": "B",
          "nepali": "आराम गर्नु पर्छ।",
          "romanized": "aaraam garnu parchha.",
          "korean": "쉬어야 합니다."
        }
      ]
    },
    {
      "title": "PART II: PRACTICE (c) 소유와 선물",
      "lines": [
        {
          "speaker": "A",
          "nepali": "तपाईं सँग कसको लागि चिठी छ ?",
          "romanized": "tapaaï saṅga kasko laagi chiThi chha ?",
          "korean": "당신은 누구를 위한 편지를 가지고 있습니까?"
        },
        {
          "speaker": "B",
          "nepali": "म सँग मेरो आमाको लागि चिठी छ।",
          "romanized": "ma saṅga mero aamaako laagi chiThi chha.",
          "korean": "제 어머니를 위한 편지를 가지고 있습니다."
        },
        {
          "speaker": "A",
          "nepali": "त्यो उपहार कसको लागि हो ?",
          "romanized": "tyo upahaar kasko laagi ho ?",
          "korean": "그 선물은 누구를 위한 것입니까?"
        },
        {
          "speaker": "B",
          "nepali": "यो मेरो साथीको लागि हो।",
          "romanized": "yo mero saathiko laagi ho.",
