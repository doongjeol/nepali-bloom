  "dialogues": [
    {
      "title": "PART I: DIALOGUE (a) 물건 분실과 기억 (-daakheri)",
      "lines": [
        {
          "speaker": "A",
          "nepali": "तपाईंले के खोज्नु भएको ?",
          "romanized": "tapaaïle ke khojnu bhaeko ?",
          "korean": "당신은 무엇을 찾고 있습니까?"
        },
        {
          "speaker": "B",
          "nepali": "मैले मेरो कलम खोजेको।",
          "romanized": "maile mero kalam khojeko.",
          "korean": "제 펜을 찾고 있습니다."
        },
        {
          "speaker": "A",
          "nepali": "कहाँ हराएको ?",
          "romanized": "kahãã haraaeko ?",
          "korean": "어디서 잃어버렸나요?"
        },
        {
          "speaker": "B",
          "nepali": "थाहा छैन।",
          "romanized": "thaahaa chhaina.",
          "korean": "모르겠습니다."
        },
        {
          "speaker": "A",
          "nepali": "चिठी लेख्दाखेरि तपाईं सँग थियो ?",
          "romanized": "chiThi lekhdaakheri tapaaï saṅga thiyo ?",
          "korean": "편지를 쓸 때 당신에게 있었나요?"
        },
        {
          "speaker": "B",
          "nepali": "थियो।",
          "romanized": "thiyo.",
          "korean": "네, 있었습니다."
        },
        {
          "speaker": "A",
          "nepali": "त्यसपछि के गर्नुभयो ?",
          "romanized": "tyaspachhi ke garnubhayo ?",
          "korean": "그 후에 무엇을 했습니까?"
        },
        {
          "speaker": "B",
          "nepali": "त्यसपछि म बाहिर गएँ।",
          "romanized": "tyaspachhi ma baahira gaẽ.",
          "korean": "그 후에 밖으로 나갔습니다."
        }
      ]
    },
    {
      "title": "PART I: DIALOGUE (b) 분실물 찾기",
      "lines": [
        {
          "speaker": "A",
          "nepali": "बाटोमा हराएको होला।",
          "romanized": "baaTomaa haraaeko holaa.",
          "korean": "길에서 잃어버렸나 보네요."
        },
        {
          "speaker": "B",
          "nepali": "होला, म फेरि खोज्छु।",
          "romanized": "holaa, ma pheri khojchhu.",
          "korean": "아마도요, 다시 찾아보겠습니다."
        },
        {
          "speaker": "A",
          "nepali": "पाउनुभयो ?",
          "romanized": "paaunubhayo ?",
          "korean": "찾았습니까?"
        },
        {
          "speaker": "B",
          "nepali": "पाएँ, ब्ल्याकबोर्डनिर रहेछ।",
          "romanized": "paaẽ, blyaakborDnira rahechha.",
          "korean": "찾았습니다, 칠판 근처에 있더군요."
        }
      ]
    },
    {
      "title": "PART II: PRACTICE (a) 동시 동작 연습 (-daakheri)",
      "lines": [
        {
          "speaker": "A",
          "nepali": "नेपालमा हिँड्दाखेरि तपाईंले के देख्नुभयो ?",
          "romanized": "nepaalmaa hĩDdaakheri tapaaïle ke dekhnubhayo ?",
          "korean": "네팔에서 걸어 다닐 때 무엇을 보았습니까?"
        },
        {
          "speaker": "B",
          "nepali": "मैले धेरै पहाड देखेँ।",
          "romanized": "maile dherai pahaaD dekhẽ.",
          "korean": "많은 산을 보았습니다."
        },
        {
          "speaker": "A",
          "nepali": "खाना खाँदाखेरि बोल्नु हुन्छ ?",
          "romanized": "khaanaa khaadaakheri bolnu hunchha ?",
          "korean": "밥을 먹을 때 말을 하나요?"
        },
        {
          "speaker": "B",
          "nepali": "नेपालीहरू खाना खाँदाखेरि बोल्दैनन्।",
          "romanized": "nepaaliharu khaanaa khaadaakheri boldainan.",
          "korean": "네팔 사람들은 밥 먹을 때 말을 하지 않습니다."
        },
        {
          "speaker": "A",
          "nepali": "तपाईं नेपाली सिक्दाखेरि के गर्नुहुन्छ ?",
          "romanized": "tapaaï nepaali sikdaakheri ke garnuhunchha ?",
          "korean": "당신은 네팔어를 배울 때 무엇을 합니까?"
        },
        {
          "speaker": "B",
          "nepali": "म नेपाली सिक्दाखेरि धेरै लेख्छु।",
          "romanized": "ma nepaali sikdaakheri dherai lekhchhu.",
          "korean": "저는 네팔어를 배울 때 많이 씁니다."
        }
      ]
    },
    {
      "title": "PART II: PRACTICE (b) 돈 분실 상황",
      "lines": [
        {
          "speaker": "A",
          "nepali": "तपाईंको के हराएको ?",
          "romanized": "tapaaïko ke haraaeko ?",
          "korean": "무엇을 잃어버렸습니까?"
        },
        {
          "speaker": "B",
          "nepali": "मेरो पैसा हराएको।",
          "romanized": "mero paisaa haraaeko.",
          "korean": "돈을 잃어버렸습니다."
        },
        {
          "speaker": "A",
          "nepali": "कति हराएको ?",
          "romanized": "kati haraaeko ?",
          "korean": "얼마나 잃어버렸나요?"
        },
        {
          "speaker": "B",
          "nepali": "पच्चीस रुपियाँ मात्रै।",
          "romanized": "pachchis rupiyaa maatrai.",
          "korean": "25루피밖에 안 됩니다."
        },
        {
          "speaker": "A",
          "nepali": "कहाँ हराएको, सम्झनु हुन्छ ?",
          "romanized": "kahãã haraaeko, samjhannu hunchha ?",
          "korean": "어디서 잃어버렸는지 기억나나요?"
        },
        {
          "speaker": "B",
          "nepali": "बजार जाँदाखेरि हराएको होला।",
          "romanized": "bajaar jaadaakheri haraaeko holaa.",
          "korean": "시장에 갈 때 잃어버린 것 같습니다."
        }
      ]
    }
