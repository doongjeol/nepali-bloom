        { "speaker": "A", "nepali": "के भएको थियो ?", "romanized": "ke bhayeko thiyo?", "korean": "무슨 일이 있었나요?" },
        { "speaker": "B", "nepali": "म पहाडबाट लड्न लागेको थिएँ।", "romanized": "ma pahaaDbaaTa ladna laageko thié.", "korean": "제가 산에서 떨어질 뻔했거든요." },
        { "speaker": "A", "nepali": "त्यसपछि के भयो ?", "romanized": "tyaspachhi ke bhayo?", "korean": "그 후엔 어떻게 됐나요?" },
