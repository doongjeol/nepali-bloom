  "grammar": [
    {
      "title": "1. 가격 묻기 (-ko kati)",
      "details": [
        "단위나 수량 뒤에 조사 '-ko'를 붙여 '~에 얼마'인지 묻는 표현입니다."
      ],
      "examples": [
        "ek kiloko kati ? (1킬로에 얼마입니까?)",
        "euTaako kati ho ? (한 개에 얼마인가요?)"
      ]
    },
    {
      "title": "2. 합계 말하기 (jammaa ~ bhayo)",
      "details": [
        "물건을 여러 개 산 후 '전부 얼마인가요?'라고 총액을 물어볼 때 사용합니다.",
        "'bhayo'는 '되었다(became)'라는 의미로 가격이 총 얼마가 되었는지를 표현합니다."
      ],
      "examples": [
        "jammaa kati bhayo ? (전부 얼마인가요?)",
        "jammaa das rupiyãã bhayo. (합해서 10루피입니다.)"
      ]
    },
    {
      "title": "3. 가격 흥정하기 (mahango / sasto)",
      "details": [
        "가격을 흥정할 때 '비싸다(mahango)'와 '싸다(sasto)'를 사용합니다.",
        "형용사를 꾸미는 부사 'ali(조금)'를 함께 사용하여 더 자연스럽게 말할 수 있습니다."
      ],
      "examples": [
        "mahango bhayo. (너무 비싸네요.)",
        "ali sasto dinos. (조금 더 싸게 주세요.)"
      ]
    },
    {
      "title": "4. 정중하게 요청하기 (-dinos)",
      "details": [
        "물건을 살 때 '~주세요'라는 의미로 동사 'dinu(주다)'의 존칭 명령형인 'dinos'를 사용합니다."
      ],
      "examples": [
        "pachchismaa dinos. (25루피에 주세요.)",
        "chaarwaTaa dinos. (네 개 주세요.)"
      ]
    },
    {
      "title": "5. 개수 단위사 (-waTaa)",
      "details": [
        "낱개로 된 물건을 세거나 살 때 숫자 뒤에 접미사 '-waTaa'를 붙여 표현합니다. (1개는 euTaa)"
      ],
      "examples": [
        "katiwaTaa line ? (몇 개 사시겠습니까?)",
        "chaarwaTaa dinos. (네 개 주세요.)"
      ]
    }
  ],
