{
  "title": "BASIC COURSE IN SPOKEN NEPALI - LESSON 6",
  "vocabulary": [
    { "nepali": "aap", "english": "mango", "korean": "망고" },
    { "nepali": "aliali", "english": "a little, a few", "korean": "조금, 약간" },
    { "nepali": "chaahīdaina", "english": "isn't needed", "korean": "필요 없다" },
    { "nepali": "DaT pen", "english": "ball point pen", "korean": "볼펜" },
    { "nepali": "dherai", "english": "many, a lot of", "korean": "많은" },
    { "nepali": "khukuri", "english": "a brand of cigarettes", "korean": "네팔 담배 브랜드" },
    { "nepali": "kehi", "english": "any, some (thing)", "korean": "무엇인가, 조금의" },
    { "nepali": "khaam", "english": "envelope", "korean": "봉투" },
    { "nepali": "lyaaidinu", "english": "to bring for some one", "korean": "~를 위해 가져다주다" },
    { "nepali": "maatra", "english": "only", "korean": "오직, ~만" },
    { "nepali": "paakeT", "english": "packet", "korean": "갑, 팩" },
    { "nepali": "paisaa", "english": "paisa", "korean": "네팔 화폐 단위 / 돈" },
    { "nepali": "parchha", "english": "costs", "korean": "비용이 들다" },
    { "nepali": "pardaina", "english": "does not cost", "korean": "비용이 들지 않다" },
    { "nepali": "saaDhe", "english": "half", "korean": "절반 / 시간의 '30분'" },
    { "nepali": "sisaa kalam", "english": "pencil", "korean": "연필" },
    { "nepali": "sisi", "english": "bottle", "korean": "병" },
    { "nepali": "syaau", "english": "apple", "korean": "사과" },
    { "nepali": "tibbati", "english": "Tibetan", "korean": "티베트의" },
    { "nepali": "Thik", "english": "O.K., all right", "korean": "좋다, 괜찮다" }
  ],
  "dialogues": [
    {
      "part": "a",
      "title": "시장 심부름",
      "conversations": [
        {
          "id": 1,
          "nepali": "ma bajaar jaane. / tapaaïlaai kehi chaahinchha / chaahinchha ?",
          "pronunciation": "",
          "translation": "(저 시장에 가요. /뭐 필요한 거 있어요?/ 네, 필요해요.)"
        },
        {
          "id": 2,
          "nepali": "ke ke chaahinchha ? / ek baTTaa churoT. ?",
          "pronunciation": "",
          "translation": "(뭐뭐가 필요한가요? / 담배 한 갑요.)"
        },
        {
          "id": 3,
          "nepali": "kun churoT ? / khukuri.",
          "pronunciation": "",
          "translation": "(어떤 브랜드 담배요? / Khukuri 브랜드요.)"
        },
        {
          "id": 4,
          "nepali": "paisaa dinos. ma lyaai dinchhu. / linos. das rupiyãã chha.",
          "pronunciation": "",
          "translation": "(돈을 주세요. 제가 사다 줄게요. / 여기요. 10루피 여기 있습니다.)"
        }
      ]
    },
    {
      "part": "b",
      "title": "사과 사기",
      "conversations": [
        {
          "id": 1,
          "nepali": "tapaaïlaai ke chaahinchha ? / malaai syaau chaahinchha.",
          "pronunciation": "",
          "translation": "(무엇이 필요하세요? / 저는 사과가 필요합니다.)"
        },
        {
          "id": 2,
          "nepali": "kati line ? / chhawaTaa line.",
          "pronunciation": "",
          "translation": "(몇 개 살 건가요? / 6개 살 거예요.)"
        },
        {
          "id": 3,
          "nepali": "chhawaTaako saaDhe chaar rupiyaa parchha. / Thik chha, dinos.",
          "pronunciation": "",
          "translation": "(6개에 4.5루피입니다. / 좋습니다, 주세요.)"
        },
        {
          "id": 4,
          "nepali": "linos.",
          "pronunciation": "",
          "translation": "(Here, take them please.)"
        }
      ]
    },
    {
      "part": "c",
      "title": "티베트 가방 흥정",
      "conversations": [
        {
          "id": 1,
          "nepali": "tibbati jholaa kinne ? / na kinne.",
          "pronunciation": "",
          "translation": "(티베트 가방 살래요? / 안 살래요.)"
        },
        {
          "id": 2,
          "nepali": "kina ? / tapaaïko pasalamaa mahango chha.",
          "pronunciation": "",
          "translation": "(왜요? / 당신네 가게는 비싸요.)"
        },
        {
          "id": 3,
          "nepali": "mahango chhaina. euTaako paanchaas rupiyaa maatra parchha. chaalis rupiyaamaa dine ?",
          "pronunciation": "",
          "translation": "(비싸지 않아요. 하나에 겨우 50루피입니다. 40루피에 줄 수 있어요?)"
        },
        {
          "id": 4,
          "nepali": "dine, la linos.",
          "pronunciation": "",
          "translation": "(네, 드릴게요. 여기 있습니다.)"
        }
      ]
    },
    {
      "part": "d",
      "title": "학용품 구매",
      "conversations": [
        {
          "id": 1,
          "nepali": "yo pasalmaa sisaakalam paainchha ? / paainchha. katiwaTaa line ?",
          "pronunciation": "",
          "translation": "(이 가게에 연필 있나요? / 네, 있습니다. How many do you want?)"
        },
        {
          "id": 2,
          "nepali": "euTaako kati parchha ? / euTaako paanch sukaa parchha.",
          "pronunciation": "",
          "translation": "(한 자루에 얼마인가요? / 한 자루에 1루피 25파이사(5 sukaa)입니다.)"
        },
        {
          "id": 3,
          "nepali": "tinwaTaa dinos. khaam pani paainchha ? / paainchha.",
          "pronunciation": "",
          "translation": "(세 자루 주세요. 봉투도 있나요? / 네, 있습니다.)"
        },
        {
          "id": 4,
          "nepali": "khaam daswaTaa dinos. / la, linos.",
          "pronunciation": "",
          "translation": "(Give me ten, please. / Here, please take them.)"
        },
        {
          "id": 5,
          "nepali": "jammaa kati bhayo ? / saadhe chaar rupiyãã bhayo.",
          "pronunciation": "",
          "translation": "(전부 얼마인가요? / 4.5루피입니다.)"
        }
      ]
    },
    {
      "part": "e",
      "title": "",
      "conversations": [
        {
          "id": 1,
          "nepali": "अमेरिकामा आँप पाइन्छ ? / पाइन्छ ।",
          "pronunciation": "(amerikaamaa āāp paainchha ? / paainchha.)",
          "translation": "Are mangoes available in America ? / Yes."
        },
        {
          "id": 2,
          "nepali": "त्यहाँ आँप सस्तो हुन्छ कि महँगो हुन्छ ? / अलि अलि महँगो हुन्छ ।",
          "pronunciation": "(tyahāā āāp sasto hunchha ki mahango hunchha ? / ali ali mahango hunchha.)",
          "translation": "Are mangoes cheap or expensive there ? / A little expensive."
        },
        {
          "id": 3,
          "nepali": "एउटाको कति पर्छ ? / एउटाको दश रुपियाँ पर्छ ।",
          "pronunciation": "(euTaako kati parchha ? / euTaako das rupiyāā parchha.)",
          "translation": "How much does one cost ? / They are ten rupees a piece."
        },
        {
          "id": 4,
          "nepali": "यहाँ नि ? / यहाँ डेढ रुपियाँ पर्छ ।",
          "pronunciation": "(yahāā ni ? / yahāā deDh rupiyāā parchha.)",
          "translation": "How about here ? / It costs one and half rupees here."
        }
      ]
    },
    {
      "part": "f",
      "title": "",
      "conversations": [
        {
          "id": 1,
          "nepali": "तपाईंलाई सिसाकलम चाहिन्छ ? / चाहिँदैन ।",
          "pronunciation": "(tapaaīlaai sisaakalam chaahinchha ? / chaahīdaina.)",
          "translation": "Do you need any pencils ? / No, I do not need any."
        },
        {
          "id": 2,
          "nepali": "डट पेन नि ? / डट पेन चाहिन्छ ।",
          "pronunciation": "(Dat pen ni ? / DaT pen chaahinchha.)",
          "translation": "How about ballpoint pens ? / Yes, I need those."
        },
        {
          "id": 3,
          "nepali": "अरू के चाहिन्छ ? / अरू केही चाहिँदैन ।",
          "pronunciation": "(aru ke chaahinchha ? / aru kehi chaahīdaina.)",
          "translation": "What else do you need ? / I don't need anything else."
        }
      ]
    }
  ],
  "grammar_notes": [
    "1. chaahinchha: '필요하다'는 뜻의 무인칭 동사입니다. 부정형은 'chaahīdaina'(필요 없다)입니다.",
    "2. 주격 조사 'laai': 'chaahinchha'를 사용할 때, 필요로 하는 주체(사람) 뒤에 'laai'를 붙입니다. (예: malaai... chaahinchha - 나는 ...이 필요하다)",
    "3. parchha: 가격이 '얼마이다', '비용이 들다'는 의미로 쓰입니다.",
    "4. deDh / saaDhe: 'deDh'는 1과 1/2(1.5)을 의미하며, 'saaDhe'는 2 이상의 숫자와 결합하여 '반(0.5)'을 의미합니다."
  ]
}