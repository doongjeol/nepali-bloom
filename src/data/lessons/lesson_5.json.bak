    { "nepali": "manchhe", "english": "person", "korean": "사람" },
    { "nepali": "miTar", "english": "meter", "korean": "미터" },
    { "nepali": "paisa", "english": "money / paisa", "korean": "돈 / 화폐 단위" },
    { "nepali": "pasal", "english": "shop", "korean": "가게" },
    { "nepali": "pasale", "english": "shopkeeper", "korean": "가게 주인" },
    { "nepali": "pheri", "english": "again", "korean": "다시" },
    { "nepali": "rupiyaa", "english": "rupees", "korean": "루피 - 네팔 화폐 단위" },
    { "nepali": "sasto", "english": "cheap", "korean": "싼" },
    { "nepali": "tayaar", "english": "ready", "korean": "준비된" }
  ],
  "dialogues": [
    {
      "part": "a",
      "title": "쇼핑 가기",
      "conversations": [
        {
          "id": 1,
          "nepali": "नमस्ते । / नमस्ते ।",
          "pronunciation": "(namaste.! / namaste.)",
          "translation": "Hello.! / Hello."
        },
        {
          "id": 2,
          "nepali": "कहाँ जाने ? / बजार जाने ।",
          "pronunciation": "(kahãã jaane ? / bajaar jaane.)",
          "translation": "Where are you going ? / I'm going to the bazaar."
        },
        {
          "id": 3,
          "nepali": "बजारमा किन जाने ? / तरकारी किन्न जाने ।",
          "pronunciation": "(bajaarmaa kina jaane ? / tarkaari kinna jaane.)",
          "translation": "Why are you going to the bazaar ? / I'm going to buy vegetables."
        },
        {
          "id": 4,
          "nepali": "अनि कहाँ जाने ? / डेरामा फर्कने ।",
          "pronunciation": "(ani kahãã jaane ? / Deraamaa pharkane.)",
          "translation": "Where are you going then ? / I'm going to go back to my place."
        },
        {
          "id": 5,
          "nepali": "कति बजे फर्कने ? / पाँच बजे होला ।",
          "pronunciation": "(kati baje pharkane ? / pããch baje holaa.)",
          "translation": "What time are you heading back ? / Probably, at five o'clock."
        }
      ]
    },
    {
      "part": "b",
      "title": "가게에서",
      "conversations": [
        {
          "id": 1,
          "nepali": "yahãã suntalaa chha ? / chha.",
          "pronunciation": "(yahãã suntalaa chha ?) / (chha.)",
          "translation": "Do you have oranges ? / Yes, I do."
        },
        {
          "id": 2,
          "nepali": "ek kiloko kati ? / tis rupiyãã.",
          "pronunciation": "(ek kiloko kati ?) / (tis rupiyãã.)",
          "translation": "How much for a kilo ? / Thirty."
        },
        {
          "id": 3,
          "nepali": "mahango bhayo. pachchismaa dinos. / hunchha. kati kilo line ?",
          "pronunciation": "(mahango bhayo. pachchismaa dinos.) / (hunchha. kati kilo line ?)",
          "translation": "They're expensive. I'll give you twenty five rupees. / O.K. How many kilos do you want ?"
        },
        {
          "id": 4,
          "nepali": "dui kilo line. / la, linos.",
          "pronunciation": "(dui kilo line.) / (la, linos.)",
          "translation": "I'll take two kilos / Here, take them."
        }
      ]
    },
    {
      "part": "c",
      "title": "",
      "conversations": [
        {
          "id": 1,
          "nepali": "asan Tolmaa phalphul paainchha ? / paainchha.",
          "pronunciation": "(asan Tolmaa phalphul paainchha ?) / (paainchha.)",
          "translation": "Are fruits available in Asan Tole ? / Yes, they are."
        },
        {
          "id": 2,
          "nepali": "chij ni ? / chij ta paaïdaina.",
          "pronunciation": "(chij ni ?) / (chij ta paaïdaina.)",
          "translation": "How about cheese ? / No, cheese is not available."
        },
        {
          "id": 3,
          "nepali": "chij kahãã paainchha ta ? / niuroDmaa paainchha.",
          "pronunciation": "(chij kahãã paainchha ta ?) / (niuroDmaa paainchha.)",
          "translation": "Where is cheese found then ? / It's found in New Road."
        },
        {
          "id": 4,
          "nepali": "ek kiloko kati parchha ? / ek saya chaalis rupiyãã parchha.",
          "pronunciation": "(ek kiloko kati parchha ?) / (ek saya chaalis rupiyãã parchha.)",
          "translation": "How much is a kilo ? / It costs 140 rupees."
        }
      ]
    },
    {
      "part": "d",
      "title": "",
      "conversations": [
        {
          "id": 1,
          "nepali": "e saahuji ! phul chha ? / chha. katiwaTaa line ?",
          "pronunciation": "(e saahuji ! phul chha ?) / (chha. katiwaTaa line ?)",
          "translation": "Oh shopkeeper ! Do you have eggs ? / Yes, I do. How many would you like ?"
        },
        {
          "id": 2,
          "nepali": "euTaako kati ho ? / pããch mohor.",
          "pronunciation": "(euTaako kati ho ?) / (pããch mohor.)",
          "translation": "How much are they a piece ? / Two and a half rupees."
        },
        {
          "id": 3,
          "nepali": "chaarwaTaa dinos. / linos.",
          "pronunciation": "(chaarwaTaa dinos.) / (linos.)",
          "translation": "Give me four, please. / Here, take them, please."
        },
        {
          "id": 4,
          "nepali": "jammaa kati bhayo ? / das rupiyãã.",
          "pronunciation": "(jammaa kati bhayo ?) / (das rupiyãã.)",
          "translation": "How much does it come to ? / Ten rupees."
        }
      ]
    }
  ],
  "grammar_notes": [
    "1. mahanago / sasto: 가격이 비싸고 쌈을 나타내는 형용사입니다.",
    "2. miTar: 옷감 등을 잴 때 사용하는 단위입니다.",
    "3. ali: '조금', '약간'이라는 뜻으로 형용사를 수식합니다. (예: ali sasto - 조금 더 싼)",
    "4. jammaa: 합계를 나타낼 때 사용합니다.",
    "5. bhaayo: '되었다'는 뜻으로, 합계 금액을 말할 때 \"전부 ~원입니다(되었습니다)\"의 맥락으로 쓰입니다.",
    "6. -aa/-o ending adjectives: 네팔어 형용사 중 'o'나 'aa'로 끝나는 것들은 수식하는 명사의 성/수에 따라 변하기도 하지만, 구어체에서는 주로 기본형을 많이 사용합니다."
  ]
}