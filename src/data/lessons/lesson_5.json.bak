{
  "title": "BASIC COURSE IN SPOKEN NEPALI - LESSON 5",
  "vocabulary": [
    { "nepali": "ali", "english": "a little", "korean": "조금" },
    { "nepali": "arkho", "english": "another", "korean": "다른 것, 다음의" },
    { "nepali": "barun", "english": "Barun", "korean": "인명" },
    { "nepali": "bhaayo", "english": "became / it is enough", "korean": "되었다 / 충분하다" },
    { "nepali": "dhanyabaad", "english": "thank you", "korean": "감사합니다" },
    { "nepali": "hernu", "english": "to look, to see", "korean": "보다" },
    { "nepali": "hunchha", "english": "okay / it is", "korean": "좋습니다 / 그렇습니다" },
    { "nepali": "jaaű", "english": "let's go", "korean": "갑시다" },
    { "nepali": "jammaa", "english": "in total", "korean": "전부, 합계" },
    { "nepali": "kaparaa", "english": "cloth, clothes", "korean": "옷, 천" },
    { "nepali": "kati", "english": "how much", "korean": "얼마나" },
    { "nepali": "khusi", "english": "happy", "korean": "기쁜" },
    { "nepali": "kinmel", "english": "shopping", "korean": "쇼핑" },
    { "nepali": "lau", "english": "well / okay", "korean": "자 / 여기요" },
    { "nepali": "lina", "english": "to take / to buy", "korean": "사러, 가지러" },
