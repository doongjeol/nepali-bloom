  "dialogues": [
    {
      "title": "PART I: DIALOGUE (a) 날씨 비교",
      "lines": [
        {
          "speaker": "A",
          "nepali": "काठमाण्डुमा जाडो छ ?",
          "romanized": "kaaThmaaNDumaa jaaDo chha ?",
