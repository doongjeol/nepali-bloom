          "nepali": "छ।",
          "romanized": "chha.",
          "korean": "네, 춥습니다."
        },
        {
          "speaker": "A",
          "nepali": "नेपालगन्जमा नि ?",
          "romanized": "nepaalgunjmaa ni ?",
          "korean": "네팔군지는요?"
        },
        {
          "speaker": "B",
          "nepali": "नेपालगन्जमा काठमाण्डुभन्दा धेरै गर्मी छ।",
          "romanized": "nepaalgunjmaa kaaThmaaNDumaa bhandaa dherai garmi chha.",
          "korean": "네팔군지는 카트만두보다 훨씬 덥습니다."
        },
        {
          "speaker": "A",
          "nepali": "कुन शहर धेरै ठूलो छ ?",
          "romanized": "kun shahar dherai Thulo chha ?",
          "korean": "어느 도시가 더 큽니까?"
        },
        {
          "speaker": "B",
          "nepali": "नेपालगन्जभन्दा काठमाण्डु धेरै ठूलो छ।",
          "romanized": "nepaalgunj bhandaa kaaThmaaNDu dherai Thulo chha.",
          "korean": "네팔군지보다 카트만두가 훨씬 더 큽니다."
        }
      ]
    },
    {
      "title": "PART I: DIALOGUE (b) 최상급 표현",
      "lines": [
        {
          "speaker": "A",
