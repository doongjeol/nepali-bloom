        {
          "speaker": "B",
          "nepali": "छैन, ऊ मभन्दा होचो छ।",
          "romanized": "chhaina, u ma bhandaa hocho chha.",
          "korean": "아니요, 그는 저보다 키가 작습니다."
        }
