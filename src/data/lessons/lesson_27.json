        { "speaker": "B", "nepali": "आऊ, भित्र आउन हुन्छ।", "romanized": "aau, bhitra aauna hunchha", "korean": "응, 들어와도 돼." },
        { "speaker": "A", "nepali": "म यहाँ बसूँ ?", "romanized": "ma yahãã basu ?", "korean": "내가 여기 앉을까?" },
        { "speaker": "B", "nepali": "हुन्छ, बस्न हुन्छ।", "romanized": "hunchha, basna hunchha", "korean": "응, 앉아도 돼." },
