          "romanized": "mero naam Tim ho.",
          "korean": "제 이름은 Tim입니다."
        },
        {
          "speaker": "A",
          "nepali": "तपाईंको घर कहाँ हो ?",
          "romanized": "tapaaïko ghar kahãã ho ?",
          "korean": "당신의 고향은 कहाँ(어디)입니까?"
        },
        {
          "speaker": "B",
          "nepali": "मेरो घर अमेरिका हो।",
          "romanized": "mero ghar amerikaa ho.",
          "korean": "제 고향은 미국입니다."
        },
        {
          "speaker": "A",
          "nepali": "तपाईं कुन भाषा बोल्नुहुन्छ ?",
