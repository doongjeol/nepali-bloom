  "dialogues": [
    {
      "title": "PART I: DIALOGUE (a) 언어 학습",
      "lines": [
        {
          "speaker": "A",
          "nepali": "तिम्रो नाम के हो ?",
          "romanized": "timro naam ke ho ?",
          "korean": "너의 이름은 무엇이니?"
        },
        {
          "speaker": "B",
          "nepali": "मेरो नाम टिम हो।",
          "romanized": "mero naam Tim ho.",
          "korean": "내 이름은 Tim이야."
        },
        {
          "speaker": "A",
          "nepali": "तिमी कुन भाषा बोल्छौ ?",
          "romanized": "timi kun bhaashaa bolchhau ?",
          "korean": "너는 어떤 언어를 말하니?"
        },
        {
          "speaker": "B",
          "nepali": "म अंग्रेजी बोल्छु।",
          "romanized": "ma angreji bolchhu.",
          "korean": "나는 영어를 말해."
        },
        {
          "speaker": "A",
          "nepali": "अहिले तिमी कुन भाषा सिक्दैछौ ?",
          "romanized": "ahile timi kun bhaashaa sikdaichhau ?",
          "korean": "지금 너는 어떤 언어를 배우고 있니?"
        },
        {
          "speaker": "B",
          "nepali": "अहिले म नेपाली सिक्दैछु।",
          "romanized": "ahile ma nepaali sikdaichhu.",
          "korean": "지금 나는 네팔어를 배우고 있어."
        },
        {
          "speaker": "A",
          "nepali": "नेपाली कति महिना पढ्छौ ?",
          "romanized": "nepaali kati mahinaa paDhchhau ?",
          "korean": "네팔어를 몇 달 동안 공부할 거니?"
        },
        {
          "speaker": "B",
          "nepali": "तीन महिना पढ्छु।",
          "romanized": "tin mahinaa paDhchhu.",
          "korean": "세 달 동안 공부할 거야."
        }
      ]
    },
    {
      "title": "PART I: DIALOGUE (b) 일과 시간",
      "lines": [
        {
          "speaker": "A",
          "nepali": "तपाईं कति बजे उठ्नुहुन्छ ?",
          "romanized": "tapaal kati baje uThnuhunchha ?",
          "korean": "당신은 몇 시에 일어나시나요?"
        },
        {
          "speaker": "B",
          "nepali": "म छ बजे उठ्छु।",
          "romanized": "ma chha baje uThchhu.",
          "korean": "저는 6시에 일어납니다."
        },
        {
          "speaker": "A",
          "nepali": "कति बजे सुत्नुहुन्छ नि ?",
          "romanized": "kati baje sutnuhunchha ni ?",
          "korean": "그럼 몇 시에 주무시나요?"
        },
        {
          "speaker": "B",
          "nepali": "म दस बजे सुत्छु।",
          "romanized": "ma das baje sutchhu.",
          "korean": "저는 10시에 잡니다."
        },
        {
          "speaker": "A",
          "nepali": "तपाईं कति बजे अफिस जानुहुन्छ ?",
          "romanized": "tapaaï kati baje aphis jaanuhunchha ?",
          "korean": "당신은 몇 시에 사무실에 ग나요?"
        },
        {
          "speaker": "B",
          "nepali": "म आठ बजे अफिस जान्छु।",
          "romanized": "ma aaTh baje aphis jaanchhu.",
          "korean": "저는 8시에 사무실에 갑니다."
        }
      ]
    },
    {
      "title": "PART II: PRACTICE (a) सि각 묻고 답하기",
      "lines": [
        {
          "speaker": "A",
          "nepali": "अहिले कति बज्यो ?",
          "romanized": "ahile kati bajyo ?",
          "korean": "지금 몇 시입니까?"
        },
        {
          "speaker": "B",
          "nepali": "अहिले पाँच बज्यो।",
          "romanized": "ahile paach bajyo.",
          "korean": "지금 5시입니다."
        },
        {
          "speaker": "A",
          "nepali": "तिमी सवा पाँच बजे के गर्छौ ?",
          "romanized": "timi sawaa paach baje ke garchhau ?",
          "korean": "너는 5시 15분에 무엇을 하니?"
        },
        {
          "speaker": "B",
          "nepali": "चिया खान्छु।",
          "romanized": "chiyaa khaanchhu.",
          "korean": "차를 마셔."
        },
        {
          "speaker": "A",
          "nepali": "फुटबल खेल्न कति बजे जान्छौ ?",
          "romanized": "phuTbal khelna kati baje jaanchhau ?",
          "korean": "축구하러 몇 시에 ग니?"
        },
        {
          "speaker": "B",
          "nepali": "साढे पाँच बजे जान्छु।",
          "romanized": "saaDhe paach baje jaanchhu.",
          "korean": "5시 30분에 ग."
        }
      ]
    },
    {
      "title": "PART II: PRACTICE (b) 식습관 (미국인과 네팔인)",
      "lines": [
        {
          "speaker": "A",
          "nepali": "अमेरिकीहरू दाल भात खान्छन् ?",
          "romanized": "amerikaaliharu daal bhaat khaanchhan ?",
          "korean": "미국인들은 달밧(밥)을 먹나요?"
        },
        {
          "speaker": "B",
          "nepali": "खाँदैनन्।",
          "romanized": "khaadainan.",
          "korean": "아니요, 먹지 않습니다."
        },
        {
          "speaker": "A",
          "nepali": "के खान्छन् त ?",
          "romanized": "ke khaanchhan ta ?",
          "korean": "그럼 무엇을 먹나요?"
        },
        {
          "speaker": "B",
          "nepali": "मासु र आलु खान्छन्।",
          "romanized": "maasu ra aalu khaanchhan.",
          "korean": "고기와 감자를 먹습니다."
        },
        {
          "speaker": "A",
          "nepali": "बियर नि ?",
          "romanized": "biyar ni ?",
          "korean": "맥주는요?"
        },
        {
          "speaker": "B",
          "nepali": "बियर धेरै जसो खान्छन्।",
          "romanized": "biyar dherai jaso khaanchhan.",
          "korean": "맥주는 보통 자주 마십니다."
        },
        {
          "speaker": "A",
          "nepali": "तपाईं सधैँ रक्सी खानुहुन्छ ?",
          "romanized": "tapaat sadhaï raksi khaanuhunchha ?",
          "korean": "당신은 항상 술을 마시나요?"
        },
        {
          "speaker": "B",
          "nepali": "खाँदिन। कहिले काहीँ मात्र खान्छु।",
          "romanized": "khaanna. kahile kaahi maatra khaanchhu.",
          "korean": "아니요. 가끔만 마십니다."
        }
      ]
    }
  ]
